  for (const value of hashes) {
    const hash = (await $2`git -C ${assignment.worktree} rev-parse ${value}^{commit}`.text()).trim();
    if (!hash)
      throw new Error(`Commit '${value}' is not a commit in ${assignment.worktree}.`);
    const subject = (await $2`git -C ${assignment.worktree} show -s --format=%s ${hash}`.text()).trim();
    const message = (await $2`git -C ${assignment.worktree} show -s --format=%B ${hash}`.text()).trim();
    if (/^(claim|triage|close)\(/.test(subject))
      throw new Error(`Commit '${hash}' is Docket state evidence, not an implementation commit.`);
    if (!message.includes(taskId))
      throw new Error(`Commit '${hash}' is not associated with ${taskId}. Include the task ID in its commit message.`);
